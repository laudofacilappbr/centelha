---
import Logo from './Logo.astro';
import StoreButtons from './StoreButtons.astro';
import { SITE } from '../config';
import { apoio } from '../lib/apoio';
import { campanhasPublicadas } from '../lib/campanhas';
import SeletorIdioma from './SeletorIdioma.astro';
import { TEXTOS, type Alternativa, type Lingua } from '../lib/idiomas';

interface Props {
  lingua?: Lingua;
  alternativas?: Alternativa[];
}
const { lingua = 'pt', alternativas = [] } = Astro.props;
// Nos outros idiomas (#48), as páginas do projeto só existem em português: o rodapé
// mostra as de ajuda com o aviso, no idioma da página.
const t = lingua === 'pt' ? undefined : TEXTOS[lingua];

const ano = new Date().getFullYear();
const { ligado: apoioLigado } = await apoio();
const temCampanha = (await campanhasPublicadas()).length > 0;
// Na página dos pais do Kids, nada de pedido de dinheiro, nem no rodapé.
const kids = Astro.url.pathname.startsWith('/kids');
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo width={150} />
        <p class="muted">{t ? t.rodape : `${SITE.assinatura} ${SITE.slogan} Obras em domínio público, narração por IA com revisão humana.`}</p>
        <StoreButtons lingua={lingua} />
      </div>

      {
        !t && (
          <nav aria-label="Projeto" class="col">
            <h2>Projeto</h2>
            <ul>
              <li><a href="/sobre">Sobre o Centelhar</a></li>
              <li><a href="/como-fazemos">Como fazemos</a></li>
              <li><a href="/temas">Temas</a></li>
              <li><a href="/glossario">Glossário</a></li>
              <li><a href="/kids">Centelhar Kids</a></li>
              <li><a href="/transparencia">Transparência</a></li>
              {!kids && <li>{apoioLigado ? <a href="/apoie">Apoie</a> : <span class="muted">Apoie (em breve)</span>}</li>}
              {!kids && temCampanha && <li><a href="/campanhas">Campanhas</a></li>}
            </ul>
          </nav>
        )
      }

      <nav aria-label={t?.ajuda ?? 'Ajuda e documentos legais'} class="col">
        <h2>{t?.ajuda ?? 'Ajuda'}</h2>
        <ul>
          {[
            ['/suporte', t?.suporte ?? 'Suporte'],
            ['/privacidade', t?.privacidade ?? 'Privacidade'],
            ['/termos', t?.termos ?? 'Termos de uso'],
          ].map(([href, rotulo]) => (
            <li>
              <a href={href} hreflang={t ? 'pt-BR' : undefined}>
                {rotulo}
              </a>
              {t && <span class="muted"> {t.emPortugues}</span>}
            </li>
          ))}
        </ul>
      </nav>

      <div class="col">
        <h2>{t?.idioma ?? 'Idioma'}</h2>
        <SeletorIdioma lingua={lingua} alternativas={alternativas} rotulo={t?.idioma ?? 'Idioma'} />
      </div>

      {
        !t && (
      <div class="col">
        <h2>Redes</h2>
        {
          SITE.redes.length ? (
            <ul>
              {SITE.redes.map((r) => (
                <li>
                  <a href={r.url} rel="noopener me">
                    {r.nome}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">Perfis nas redes sociais em breve.</p>
          )
        }
      </div>
        )
      }
    </div>
    <p class="legal muted">
      © {ano} Centelhar. {t ? t.legal : 'Textos de Allan Kardec em domínio público. Feito com cuidado e sem anúncios.'}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-12) var(--space-8);
  }
  .top {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 820px) {
    .top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
  .about :global(.logo) {
    margin-bottom: var(--space-4);
  }
  .col h2 {
    font-size: 1rem;
    margin-bottom: var(--space-3);
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .col li {
    margin-bottom: var(--space-2);
  }
  .col a {
    color: var(--text-primary);
  }
  .legal {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    max-width: none;
  }
</style>
