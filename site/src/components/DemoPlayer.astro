---
/**
 * Player de demonstração: questão 88 de O Livro dos Espíritos com o texto
 * destacado acompanhando o áudio. Dados de src/lib/demo.ts: da API quando a obra
 * está publicada (o trecho da questão dentro do áudio do capítulo), senão de
 * src/data/q88.json. Sem áudio, o player mostra "áudio de demonstração em breve"
 * e o texto continua legível. O áudio só é baixado quando a pessoa toca em play.
 */
import { demoQ88 } from '../lib/demo';

const q88 = await demoQ88();
const segmentos = q88.segmentos;
---

<div
  class="player card"
  data-player
  data-audio={q88.audio?.url ?? ''}
  data-inicio-audio={q88.audio?.inicio ?? 0}
  data-fim-audio={q88.audio?.fim ?? 0}
>
  <div class="player-head">
    <img src="/brand/symbol-flat.svg" alt="" width="40" height="40" class="spark" />
    <div>
      <p class="obra">{q88.obra}</p>
      <p class="ref muted">Questão 88 · {q88.referencia}</p>
    </div>
  </div>

  {/* Texto estático (sem API): conferir redação na edição-fonte, Guillon Ribeiro. */}
  <blockquote class="texto" lang="pt-BR" data-texto>
    {
      segmentos.map((s, i) => (
        <span class:list={['seg', `seg-${s.papel}`]} data-i={i} data-inicio={s.inicio} data-fim={s.fim}>
          {s.texto}{' '}
        </span>
      ))
    }
  </blockquote>
  <p class="fonte muted">{q88.traducao}. Texto em domínio público.</p>

  <div class="controls" data-controls hidden>
    <button type="button" class="play" data-play aria-label="Ouvir a questão 88">
      <svg class="i-play" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
      </svg>
      <svg class="i-pause" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"></path>
      </svg>
    </button>
    <div class="track">
      <label class="visually-hidden" for="q88-pos">Posição do áudio</label>
      <input id="q88-pos" type="range" min="0" max="100" step="0.1" value="0" data-seek disabled />
      <div class="times muted" aria-hidden="true">
        <span data-cur>0:00</span>
        <span data-dur>0:00</span>
      </div>
    </div>
  </div>
  <p class="status" data-status role="status" aria-live="polite"></p>
  <noscript><p class="status">Ative o JavaScript para ouvir a demonstração. O texto acima pode ser lido normalmente.</p></noscript>
</div>

<script>
  const fmt = (t: number) => {
    if (!Number.isFinite(t) || t < 0) t = 0;
    const m = Math.floor(t / 60);
    const s = Math.floor(t % 60);
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
    const src = root.dataset.audio ?? '';
    // Trecho da questão dentro do áudio do capítulo, em segundos. O tempo mostrado,
    // a barra e o destaque são relativos a ele; fora dele, o player não toca.
    const ini = Number(root.dataset.inicioAudio) || 0;
    const fimAudio = Number(root.dataset.fimAudio) || 0;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const cur = root.querySelector<HTMLElement>('[data-cur]')!;
    const dur = root.querySelector<HTMLElement>('[data-dur]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const segs = Array.from(root.querySelectorAll<HTMLElement>('.seg'));
    const tempos = segs.map((el) => ({
      el,
      inicio: Number(el.dataset.inicio),
      fim: Number(el.dataset.fim),
    }));
    const total = fimAudio > ini ? fimAudio - ini : tempos.length ? tempos[tempos.length - 1].fim : 0;
    dur.textContent = fmt(total);
    controls.hidden = false;

    let audio: HTMLAudioElement | null = null;
    let indisponivel = !src;
    if (indisponivel) {
      play.disabled = true;
      status.textContent = 'Áudio de demonstração em breve. Enquanto isso, leia o trecho acima.';
    }
    const rel = () => (audio ? audio.currentTime - ini : 0);
    // Parou no fim da questão: o retorno ao início dispara outro timeupdate, que não
    // deve destacar o primeiro trecho como se estivesse tocando.
    let noFim = false;

    const marcarIndisponivel = () => {
      indisponivel = true;
      play.disabled = true;
      seek.disabled = true;
      root.classList.remove('is-playing');
      status.textContent = 'Áudio de demonstração em breve. Enquanto isso, leia o trecho acima.';
    };

    const destacar = (t: number) => {
      let ativo: HTMLElement | null = null;
      for (const s of tempos) {
        if (t >= s.inicio && t < s.fim) ativo = s.el;
      }
      for (const s of tempos) {
        if (s.el === ativo) s.el.setAttribute('aria-current', 'true');
        else s.el.removeAttribute('aria-current');
      }
    };

    const atualizar = () => {
      if (!audio) return;
      // Arquivo só da questão (estático): a duração real manda. Trecho do capítulo:
      // a duração é a do trecho, não a do arquivo.
      const d = fimAudio > ini ? total : Number.isFinite(audio.duration) ? audio.duration : total;
      if (fimAudio > ini && audio.currentTime >= fimAudio) {
        // Fim da questão, não do arquivo: o capítulo continua, a demonstração não.
        noFim = true;
        audio.pause();
        audio.currentTime = ini;
      }
      if (noFim) {
        cur.textContent = fmt(0);
        seek.value = '0';
        destacar(-1);
        return;
      }
      const t = Math.max(0, rel());
      cur.textContent = fmt(t);
      dur.textContent = fmt(d);
      seek.value = d ? String((t / d) * 100) : '0';
      seek.setAttribute('aria-valuetext', `${fmt(t)} de ${fmt(d)}`);
      destacar(t);
    };

    const criarAudio = () => {
      const a = new Audio();
      a.preload = 'none';
      a.addEventListener('error', marcarIndisponivel);
      a.addEventListener('timeupdate', atualizar);
      a.addEventListener('loadedmetadata', atualizar);
      a.addEventListener('play', () => {
        noFim = false;
        root.classList.add('is-playing');
        play.setAttribute('aria-label', 'Pausar');
        seek.disabled = false;
      });
      a.addEventListener('pause', () => {
        root.classList.remove('is-playing');
        play.setAttribute('aria-label', 'Ouvir a questão 88');
      });
      a.addEventListener('ended', () => destacar(-1));
      a.addEventListener('loadedmetadata', () => {
        if (a.currentTime < ini) a.currentTime = ini;
      });
      a.src = src;
      return a;
    };

    play.addEventListener('click', async () => {
      if (indisponivel) return;
      if (!audio) {
        // Sem checagem prévia por fetch: o áudio vem de outra origem (domínio de áudio
        // na Cloudflare), e um fetch sem CORS falha sempre, dando o áudio como ausente.
        // O <audio> não precisa de CORS; arquivo ausente cai no evento 'error'.
        audio = criarAudio();
      }
      if (audio.paused) {
        audio.play().catch(() => {
          if (audio && audio.error) marcarIndisponivel();
        });
      } else {
        audio.pause();
      }
    });

    seek.addEventListener('input', () => {
      if (!audio) return;
      noFim = false;
      const d = fimAudio > ini ? total : audio.duration;
      if (!Number.isFinite(d)) return;
      audio.currentTime = ini + (Number(seek.value) / 100) * d;
      atualizar();
    });
  });
</script>

<style>
  .player {
    padding: var(--space-6);
    background: var(--surface);
  }
  .player-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .player-head p {
    margin: 0;
  }
  .spark {
    flex: none;
  }
  .obra {
    font-family: var(--font-display);
    font-weight: 700;
  }
  .ref {
    font-size: 0.9rem;
  }
  .texto {
    margin: 0 0 var(--space-3);
    font-size: 1.2rem;
    line-height: 1.75;
  }
  .seg {
    border-radius: 4px;
    padding: 0.05em 0.1em;
    transition: background-color 0.2s ease;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .seg-numero {
    font-weight: 700;
    color: var(--accent);
  }
  .seg-pergunta {
    font-weight: 700;
  }
  .seg-numero:not(:first-child)::before {
    content: '';
    display: block;
    height: var(--space-3);
  }
  .seg[aria-current='true'] {
    background: var(--highlight-bg);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .fonte {
    font-size: 0.85rem;
    margin-bottom: var(--space-5);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .controls[hidden] {
    display: none;
  }
  .play {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    border: 0;
    background: var(--accent);
    color: var(--accent-text);
    cursor: pointer;
  }
  .play:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .i-pause {
    display: none;
  }
  .is-playing .i-pause {
    display: block;
  }
  .is-playing .i-play {
    display: none;
  }
  .track {
    flex: 1;
    min-width: 0;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
    min-height: 24px;
  }
  .times {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .status {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
  }
  .status:empty {
    display: none;
  }
</style>
