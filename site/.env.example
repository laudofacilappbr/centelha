# URL base da API do Centelha (sem barra final). Usada no build (variável pública:
# fica embutida no JavaScript enviado ao navegador — nunca coloque segredos aqui).
# O formulário da lista de espera faz POST em ${PUBLIC_API_URL}/v1/waitlist
PUBLIC_API_URL=http://localhost:8000

# URL canônica do site (usada em canonical, Open Graph, sitemap e robots.txt).
# TODO: confirmar o domínio definitivo (centelha.com.br ainda não registrado).
SITE_URL=https://centelha.com.br

# Opcional — análise de acesso sem cookies (Plausible). Vazio = nenhuma analítica.
# A página /kids NUNCA carrega analítica, independentemente desta variável.
PUBLIC_PLAUSIBLE_DOMAIN=

# Build: de onde ler o catálogo (pode ser a rede interna, ex.: http://api:8000).
# Vazio = usa PUBLIC_API_URL. Sem API, o build segue sem as páginas do acervo.
CATALOGO_API_URL=
# 1 = o build falha se a API não responder (use no deploy, para não publicar site sem obras).
CATALOGO_OBRIGATORIO=
# Origem do storage de áudio, liberada na CSP (media-src). Ex.: https://audio.centelha.com.br
AUDIO_URL=
