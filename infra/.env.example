DOMINIO=centelha.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-forte
TAG=latest
# Motor de TTS (#1): começa no Piper, container próprio e sem chave (ADR 0005).
# As chaves abaixo ficam para a migração ao Azure.
CENTELHA_AZURE_TTS_KEY=
CENTELHA_AZURE_TTS_REGION=
CENTELHA_GOOGLE_TTS_KEY=
# "segmento" (um pedido por segmento) ou "bloco" (entonação contínua; só Google por enquanto).
CENTELHA_TTS_MODO=segmento
# Áudio cifrado (ADR 0004). Ligar só quando o app decifrar. Chave-mestra: 32 bytes em
# base64 (openssl rand -base64 32). Perdê-la torna o áudio ilegível: guarde no backup.
CENTELHA_AUDIO_CIFRAR=false
CENTELHA_AUDIO_CHAVE_MESTRA=
# Vazio = Sentry desligado. Ligar é decisão (terceiro recebendo dados; citar na política de privacidade).
CENTELHA_SENTRY_DSN=
