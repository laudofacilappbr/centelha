DOMINIO=centelhar.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-forte
TAG=latest
# Motor de TTS (#1): começa no Piper, container próprio e sem chave (ADR 0005).
# As chaves abaixo ficam para a migração ao Azure.
CENTELHA_AZURE_TTS_KEY=
CENTELHA_AZURE_TTS_REGION=
CENTELHA_GOOGLE_TTS_KEY=
# "segmento" (um pedido por segmento) ou "bloco" (entonação contínua; só Google por enquanto).
CENTELHA_TTS_MODO=segmento
# Áudio cifrado (ADR 0004). Ligar só quando o app decifrar. Chave-mestra: 32 bytes em
# base64 (openssl rand -base64 32). Perdê-la torna o áudio ilegível: guarde no backup.
CENTELHA_AUDIO_CIFRAR=false
CENTELHA_AUDIO_CHAVE_MESTRA=
# Recifrar as faixas .m4a antigas depois de ligar a cifragem (centelha-recifrar, #73):
# token da Cloudflare só com "Zone > Cache Purge" nesta zona. Vazio = purge à mão.
CENTELHA_CLOUDFLARE_ZONE_ID=
CENTELHA_CLOUDFLARE_TOKEN=
# Vazio = Sentry desligado. Ligar é decisão (terceiro recebendo dados; citar na política de privacidade).
CENTELHA_SENTRY_DSN=
# Backup diário (#26): bucket S3 (Cloudflare R2 ou Backblaze B2) criado à mão, com chave
# só de escrita e leitura nele. BACKUP_SENHA cifra tudo: guarde-a também fora da VPS
# (gerenciador de senhas); sem ela, o backup não restaura.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_SENHA=
BACKUP_RETENCAO_DIAS=30
# Hora UTC do backup diário (6 = 3h em Brasília).
BACKUP_HORA=6
