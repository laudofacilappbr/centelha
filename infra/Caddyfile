{
	# TLS com o Origin Certificate da Cloudflare; sem ACME.
	auto_https disable_certs
	servers {
		# Confia nos cabeçalhos de IP só vindos da Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare) {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip
	header -Server
}

{$DOMINIO}, www.{$DOMINIO} {
	import cloudflare
	@www host www.{$DOMINIO}
	redir @www https://{$DOMINIO}{uri} permanent
	reverse_proxy site:80
}

api.{$DOMINIO} {
	import cloudflare
	reverse_proxy api:8000
}

audio.{$DOMINIO} {
	import cloudflare
	root * /srv/audio
	# Nome do arquivo tem a versão (…-v2.m4a): conteúdo nunca muda, cache eterno.
	header Cache-Control "public, max-age=31536000, immutable"
	header Access-Control-Allow-Origin *
	file_server
}
